{
  "name": "jev-security-sentinel",
  "version": "0.8.0",
  "description": "GitHub Action that gates SAST, SCA, IaC, secrets, and container findings with Jev without hiding them.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "github-actions",
    "jev",
    "security",
    "sarif",
    "sast",
    "sca",
    "jevforge"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "ai": "^7.0.113",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
